# Browser-safe values. These may be emitted to runtime-config.js.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback if your project only exposes an anon key:
SUPABASE_ANON_KEY=
APP_URL=http://localhost:5173
MEDIQO_ASSISTANT_API_URL=/api/ask
MEDIQO_ACCOUNT_SYNC_API_URL=/api/account-sync
MEDIQO_ACCREDITATION_API_URL=/api/accreditation
MEDIQO_ACCREDITATION_EVIDENCE_API_URL=/api/accreditation-evidence

# Server-only values for Netlify Functions. Never expose these in browser code or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Preferred server-only HubSpot private app token for CRM sync:
HUBSPOT_PRIVATE_APP_TOKEN=
# Legacy fallback:
HUBSPOT_ACCESS_TOKEN=

# Existing public HubSpot embeds.
HUBSPOT_PORTAL_ID=442479260
